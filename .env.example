# Sync multi-dispositivo (OPCIONAL).
# Sin estas variables, la app funciona 100% local (localStorage).
# Con ellas, el progreso se guarda por codigo de acceso y funciona
# en cualquier telefono.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tabla necesaria en Supabase:
#   create table progreso (
#     codigo text primary key,
#     estado jsonb,
#     updated_at timestamptz default now()
#   );
